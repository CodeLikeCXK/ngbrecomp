# Cross-compile or native compile for Windows ARM64 with llvm-mingw (clang, lld, libc++, UCRT)
# against MSYS2's CLANGARM64 packages (SDL2, glib, glslang, SPIRV-Tools) unpacked into a sysroot.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64)
set(NGB_WIN_DEPS "${CMAKE_CURRENT_LIST_DIR}/../../build/windows-deps-arm64" CACHE PATH "llvm-mingw and the CLANGARM64 sysroot")
file(GLOB _llvm_mingw_candidates LIST_DIRECTORIES true "${NGB_WIN_DEPS}/llvm-mingw-*-ucrt-*")
set(_llvm_mingw "")
foreach(_item IN LISTS _llvm_mingw_candidates)
    if(IS_DIRECTORY "${_item}")
        set(_llvm_mingw "${_item}")
        break()
    endif()
endforeach()

set(_triple aarch64-w64-mingw32)
if(CMAKE_HOST_WIN32)
    set(_exe ".exe")
else()
    set(_exe "")
endif()

if(EXISTS "${_llvm_mingw}/bin/${_triple}-clang${_exe}")
    set(CMAKE_C_COMPILER "${_llvm_mingw}/bin/${_triple}-clang${_exe}")
    set(CMAKE_CXX_COMPILER "${_llvm_mingw}/bin/${_triple}-clang++${_exe}")
else()
    set(CMAKE_C_COMPILER "${_llvm_mingw}/bin/${_triple}-clang")
    set(CMAKE_CXX_COMPILER "${_llvm_mingw}/bin/${_triple}-clang++")
endif()

if(EXISTS "${_llvm_mingw}/bin/${_triple}-windres${_exe}")
    set(CMAKE_RC_COMPILER "${_llvm_mingw}/bin/${_triple}-windres${_exe}")
else()
    set(CMAKE_RC_COMPILER "${_llvm_mingw}/bin/${_triple}-windres")
endif()

if(EXISTS "${_llvm_mingw}/bin/llvm-ar${_exe}")
    set(CMAKE_AR "${_llvm_mingw}/bin/llvm-ar${_exe}")
    set(CMAKE_RANLIB "${_llvm_mingw}/bin/llvm-ranlib${_exe}")
else()
    set(CMAKE_AR "${_llvm_mingw}/bin/llvm-ar")
    set(CMAKE_RANLIB "${_llvm_mingw}/bin/llvm-ranlib")
endif()

set(NGB_WIN_SYSROOT "${NGB_WIN_DEPS}/sysroot/clangarm64")
set(CMAKE_FIND_ROOT_PATH "${NGB_WIN_SYSROOT}" "${_llvm_mingw}/${_triple}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_PREFIX_PATH "${NGB_WIN_SYSROOT}")
# pkg-config: the sysroot's .pc files only
set(ENV{PKG_CONFIG_LIBDIR} "${NGB_WIN_SYSROOT}/lib/pkgconfig:${NGB_WIN_SYSROOT}/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${NGB_WIN_DEPS}/sysroot")
set(ENV{PKG_CONFIG_PATH} "")
# The sysroot's headers for every target
set(CMAKE_C_STANDARD_INCLUDE_DIRECTORIES "${NGB_WIN_SYSROOT}/include")
set(CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES "${NGB_WIN_SYSROOT}/include")
